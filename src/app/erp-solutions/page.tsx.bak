                <li>• Event and announcement updates</li>
                <li>• Direct teacher communication</li>
              </ul>
            </motion.div>
          </motion.div>
        </div>
      </section>

      {/* Core Modules/Features Section */}
      <section className="py-16 w-full bg-white">
        <div className="container mx-auto px-4">
          <motion.div 
            initial={{ opacity: 0, y: 20 }}
            whileInView={{ opacity: 1, y: 0 }}
            viewport={{ once: true }}
            className="text-center mb-12"
          >
            <h2 className="text-3xl md:text-4xl font-bold mb-6 text-[#032D60]">
              One Platform, Tons of Features
            </h2>
            <p className="text-lg text-gray-700 max-w-2xl mx-auto">
              Everything you need to manage your institution efficiently
            </p>
          </motion.div>

          <motion.div 
            initial="hidden"
            whileInView="visible"
            viewport={{ once: true }}
            variants={staggerContainer}
            className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto"
          >
            {[
              { title: "Admission", icon: "📋", description: "Streamlined admission process and management" },
              { title: "Online Class", icon: "💻", description: "Virtual classroom and learning management" },
              { title: "Notice Board", icon: "📢", description: "Digital announcements and communication" },
              { title: "Attendance", icon: "✅", description: "Smart attendance tracking and monitoring" },
              { title: "Homework", icon: "📚", description: "Assignment creation and submission system" },
              { title: "Fee Collection", icon: "💰", description: "Automated billing and payment processing" }
            ].map((feature, index) => (
              <motion.div 
                key={index}
                variants={fadeIn}
                className="bg-white border-2 border-gray-100 rounded-2xl p-8 text-center hover:border-[#032D60] hover:shadow-lg transition-all duration-300 group"
              >
                <div className="text-5xl mb-4 group-hover:scale-110 transition-transform duration-300">
                  {feature.icon}
                </div>
                <h3 className="text-xl font-bold mb-3 text-[#032D60]">{feature.title}</h3>
                <p className="text-gray-600">{feature.description}</p>
              </motion.div>
            ))}
          </motion.div>
        </div>
      </section>

      {/* CTA Section */}
      <section className="py-16 w-full bg-gradient-to-br from-[#032D60] to-[#0176D3]">
        <div className="container mx-auto px-4 text-center">
          <motion.div 
            initial={{ opacity: 0, y: 20 }}
            whileInView={{ opacity: 1, y: 0 }}
            viewport={{ once: true }}
          >
            <h2 className="text-3xl md:text-4xl font-bold mb-6 text-white">
              Want to launch our app?
            </h2>
            <p className="text-xl text-white/90 mb-8 max-w-2xl mx-auto">
              Customize your institution's mobile app with Digiminds branding and start transforming your education management today.
            </p>
            <Button size="lg" className="bg-white text-[#032D60] hover:bg-gray-100 px-8 py-4 text-lg font-semibold">
              Schedule a Free Demo
            </Button>
          </motion.div>
        </div>
      </section>

      {/* Trusted By Section */}
      <section className="py-16 w-full bg-gray-50">
        <div className="container mx-auto px-4 text-center">
          <motion.div 
            initial={{ opacity: 0, y: 20 }}
            whileInView={{ opacity: 1, y: 0 }}
            viewport={{ once: true }}
          >
            <h2 className="text-2xl md:text-3xl font-bold mb-12 text-[#032D60]">
              Our Platforms
            </h2>
            <div className="grid grid-cols-2 md:grid-cols-4 gap-8 items-center opacity-70">
              <Image 
                src="/images/logos/Digimindglobal.png" 
                alt="Digiminds Platform" 
                width={120} 
                height={60} 
                className="h-12 w-auto mx-auto grayscale hover:grayscale-0 transition-all duration-300" 
              />
              <div className="h-12 bg-gray-200 rounded-lg flex items-center justify-center">
                <span className="text-gray-500 font-semibold">ERP Solutions</span>
              </div>
              <div className="h-12 bg-gray-200 rounded-lg flex items-center justify-center">
                <span className="text-gray-500 font-semibold">Learning Management</span>
              </div>
              <div className="h-12 bg-gray-200 rounded-lg flex items-center justify-center">
                <span className="text-gray-500 font-semibold">Campus Portal</span>
              </div>
            </div>
          </motion.div>
        </div>
      </section>
    </div>
  )
} 